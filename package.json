{
  "name": "immersionkit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @immersionkit/extension dev",
    "build": "pnpm --filter @immersionkit/shared build && pnpm --filter @immersionkit/extension build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke:extension": "node tools/smoke/extension-runtime-smoke.mjs",
    "smoke:extension:build": "pnpm build && pnpm smoke:extension",
    "benchmark": "node tools/benchmarks/run-browser-validation-suite.mjs",
    "benchmark:validation": "pnpm benchmark",
    "benchmark:nlp-performance": "pnpm --filter @immersionkit/extension benchmark:nlp:browser",
    "benchmark:contextual-word-injection": "node tools/benchmarks/run-task-02-contextual-word-injection-benchmark.mjs",
    "benchmark:phrase-detection": "node tools/benchmarks/task-03-phrase-detection.mjs",
    "benchmark:sentence-shortlisting": "node tools/benchmarks/task-04-sentence-shortlisting-runner.mjs",
    "benchmark:sentence-suitability": "node tools/benchmarks/task-05-sentence-suitability-runner.mjs",
    "benchmark:sentence-suitability:test": "pnpm --filter @immersionkit/shared exec vitest run tests/sentence-suitability-validation.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
