{
  "name": "immersionkit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "pnpm --filter @immersionkit/extension dev",
    "asset-packs:serve": "node tools/assets/asset-pack-server.mjs",
    "build": "pnpm --filter @immersionkit/shared build && pnpm --filter @immersionkit/extension build",
    "build:local-assets": "VITE_IMMERSIONKIT_ASSET_BASE_URL=http://127.0.0.1:8787/assets pnpm build",
    "build:production": "pnpm --filter @immersionkit/shared build && pnpm --filter @immersionkit/extension build:production",
    "build:production:local-assets": "VITE_IMMERSIONKIT_ASSET_BASE_URL=http://127.0.0.1:8787/assets pnpm build:production",
    "lint": "pnpm lint:code && pnpm lint:dead",
    "lint:code": "biome lint .",
    "lint:code:fix": "biome lint --write .",
    "lint:dead": "rev-dep config run",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke:extension": "node tools/smoke/extension-runtime-smoke.mjs",
    "smoke:extension:build": "pnpm build:local-assets && pnpm smoke:extension",
    "smoke:extension:production": "pnpm build:production:local-assets && IMMERSIONKIT_EXPECT_PRODUCTION_BUILD=1 pnpm smoke:extension",
    "smoke:preview": "node tools/smoke/public-preview-acceptance.mjs",
    "smoke:preview:build": "pnpm build:local-assets && pnpm smoke:preview",
    "smoke:public-web": "node tools/smoke/public-web-preview-audit.mjs",
    "smoke:public-web:build": "pnpm build:local-assets && pnpm smoke:public-web",
    "benchmark": "node tools/benchmarks/run-browser-validation-suite.mjs",
    "benchmark:validation": "pnpm benchmark",
    "benchmark:nlp-performance": "pnpm --filter @immersionkit/extension benchmark:nlp:browser",
    "benchmark:contextual-word-injection": "node tools/benchmarks/contextual-word-injection-benchmark.mjs",
    "benchmark:phrase-detection": "node tools/benchmarks/phrase-detection-benchmark.mjs",
    "benchmark:sentence-shortlisting": "node tools/benchmarks/sentence-shortlisting-benchmark.mjs",
    "benchmark:sentence-suitability": "node tools/benchmarks/sentence-suitability-benchmark.mjs",
    "benchmark:sentence-suitability:test": "pnpm --filter @immersionkit/shared exec vitest run tests/sentence-suitability-validation.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "playwright": "^1.53.0",
    "rev-dep": "^2.13.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
